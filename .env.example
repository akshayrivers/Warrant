# ==============================================================================
# Warrant Environment Configuration
# ==============================================================================

# Server
PORT=3000
HOST=0.0.0.0

# Warrant HMAC Signing Secret
# Used to sign and verify Spending Warrants. Keep this secure in production.
WARRANT_SECRET=dev-secret-warrant-signing-key-change-me

# PostgreSQL Database URL (Optional)
# If omitted or left commented, Warrant runs with an In-Memory repository.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/warrant_db

# Razorpay Test Mode Credentials (Optional)
# If omitted or left commented, Warrant uses the built-in deterministic test simulator.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Google Gemini LLM (Optional)
# If omitted, the agent falls back to a deterministic keyword-based proposer.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash